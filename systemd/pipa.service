[Unit]
Description=PiPA Personal Assistant Bot
After=network.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME/pipa
EnvironmentFile=/home/YOUR_USERNAME/pipa/credentials/.env
ExecStart=/usr/bin/python3 src/bot.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
